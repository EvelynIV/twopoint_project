{
  "mode": "center_then_flash",
  "f32c": {
    "port": "/dev/ttyAS4",
    "baudrate": 115200,
    "x_id": 1,
    "y_id": 2,
    "speed_rpm": 100,
    "startup_delay": 0.3,
    "command_interval": 0.001,
    "enable_settle_delay": 0.2,
    "debug_frames": false
  },
  "center": {
    "target_x": 0.5,
    "target_y": 0.5,
    "pid": {
      "x": {
        "kp": -10.0,
        "ki": 0.0,
        "kd": 0.0,
        "integral_limit": 0.2,
        "output_limit_deg": 1.0
      },
      "y": {
        "kp": 10.0,
        "ki": 0.0,
        "kd": 0.0,
        "integral_limit": 0.2,
        "output_limit_deg": 1.0
      }
    },
    "deadband": 0.006,
    "loop_hz": 15.0,
    "timeout": 100.0,
    "stable_frames": 3,
    "target_filter": {
      "enabled": true,
      "ema_alpha": 0.35,
      "max_jump": 0.08,
      "jump_confirm_frames": 2
    }
  },
  "laser": {
    "hold_seconds": 5.0
  },
